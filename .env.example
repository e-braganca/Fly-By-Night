# Copy to .env.local and fill in from your Supabase project (Settings → API).
# These are safe to expose to the browser (the anon key is public by design;
# row-level security is what protects your data). Also add them in
# Netlify → Site settings → Environment variables for the deployed build.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
